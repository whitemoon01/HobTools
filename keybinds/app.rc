1 ICON "app.ico"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "HobTools (fan mod)"
      VALUE "InternalName", "HobKeybinds"
      VALUE "Comments", "Changes key bindings in Hob's PLAYER_CONTROLS.TXT and HobTools.ini. Part of the HobTools mod."
      VALUE "FileDescription", "Hob Keybinds"
      VALUE "ProductName", "Hob Keybinds"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "Hob Keybinds.exe"
      VALUE "LegalCopyright", "Unofficial fan-made tool. Not affiliated with Runic Games."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
